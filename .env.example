# Copy to .env (never commit .env) and set the values, or set them as Windows/Linux environment variables.

# Required. Password for the Clipper web page and API. Use a long random string of letters and digits.
APP_ACCESS_TOKEN=change-me-to-a-long-random-string

# The variables below are used from later milestones on; Clipper M1 does not need them yet.
# GROQ_API_KEY=            # M2: transcription (Groq Whisper)
# GEMINI_API_KEY=          # M3: clip selection, titles and hashtags (Google Gemini)
# MODAL_RENDER_URL=        # M5: URL of the deployed render worker on Modal
# RENDER_SHARED_SECRET=    # M5: shared secret between Clipper and the render worker
# PUBLIC_BASE_URL=         # M7: public HTTPS address (e.g. ngrok static domain) for OAuth callbacks
# TOKEN_ENCRYPTION_KEY=    # M7: key that encrypts stored social media tokens
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
